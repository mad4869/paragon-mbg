# Salin ke .env lalu sesuaikan.

PORT=3000
APP_TITLE=Pesan Makan Siang

# Jam tutup batch harian diatur di halaman /admin (default 11.00 WIB).

# Token untuk halaman /admin. Wajib diisi agar admin bisa dipakai.
ADMIN_TOKEN=ganti-dengan-token-rahasia

# Tetap kirim rekap "tidak ada pesanan" bila batch kosong.
SEND_WHEN_EMPTY=true

# ---- WhatsApp ----
# console  : tidak mengirim, hanya menyimpan rekap ke data/outbox (untuk uji coba)
# fonnte   : via https://fonnte.com (perlu device WhatsApp tertaut di Fonnte)
# cloudapi : WhatsApp Business Cloud API resmi dari Meta
WA_PROVIDER=console

# Nomor tujuan, format internasional tanpa "+" (pisahkan dengan koma untuk beberapa nomor).
# Untuk Fonnte, ID grup WhatsApp juga bisa dipakai.
WA_TARGETS=6281234567890

# Fonnte
FONNTE_TOKEN=

# WhatsApp Cloud API
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v21.0

# Lanjutan (opsional)
# SCHEDULER_INTERVAL_MS=30000
# RETRY_DELAY_MS=300000
# MAX_SEND_ATTEMPTS=5
# DATA_DIR=data
